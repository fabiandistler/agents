{
  "enabledPlugins": {
    "architecture@fabiandistler-agents": false,
    "refactoring@fabiandistler-agents": false,
    "ai-ml@fabiandistler-agents": false,
    "workflow@fabiandistler-agents": false,
    "communication@fabiandistler-agents": false,
    "personal@fabiandistler-agents": false,
    "mattpocock-skills@mattpocock": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/pr_merge_guard.py --harness claude"
          }
        ]
      }
    ]
  }
}
