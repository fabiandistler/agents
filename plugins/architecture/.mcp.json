{
  "mcpServers": {
    "architecture-kb": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp[cli]>=1.2",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-wiki-server/server.py"
      ],
      "env": {
        "WIKI_PATH": "${CLAUDE_PLUGIN_ROOT}/kb"
      }
    }
  }
}
